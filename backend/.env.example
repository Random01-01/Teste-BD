DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DB_ENGINE=mysql
DB_NAME=aura
DB_USER=aura
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=3306
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://seu-usuario.github.io
CSRF_TRUSTED_ORIGINS=https://seu-usuario.github.io
FRONTEND_URL=https://seu-usuario.github.io/Teste-BD/
# None only for cross-site HTTPS deployments. Custom domains on the same site are recommended.
COOKIE_SAMESITE=None
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=Aura <noreply@example.com>
# Set True ONLY behind a trusted proxy that strips incoming X-Forwarded-Proto.
TRUST_PROXY=False
# Optional, development-only HTTPS iframe preview. Auto-detected on Arena.
# PREVIEW_ORIGIN=https://seu-host-de-previa.example
# Isolated test instances may select a different env file and SQLite database.
# DJANGO_ENV_FILE=backend/.env.test-preview
# DB_SQLITE_PATH=test-preview.sqlite3
# SESSION_COOKIE_NAME=aura_test_session
# CSRF_COOKIE_NAME=aura_test_csrf
# COOKIE_SECURE=True
# Dedicated HTTPS development proxy ONLY; handles platform Host rewriting.
# PREVIEW_COOKIE_POLICY=partitioned
